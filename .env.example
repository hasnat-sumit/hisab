# Copy this file to .env.local and fill in the values.

# MongoDB connection string. Keep a database name (/hisab) before the "?".
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hisab?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hisab

# Secret that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The address of the app, without a trailing slash.
# Use your real domain in production.
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob token for storing documents. Required in production.
# Create a PRIVATE Blob store in the Vercel dashboard (Storage > Blob).
# Leave empty for local development: files are saved in the .data folder.
BLOB_READ_WRITE_TOKEN=
